# Local-only secret for the relay Worker (worker/index.js). Read by the Worker
# in `npm run dev`; it is never bundled into the browser build because the
# name has no VITE_ prefix.
# Get a key at https://www.last.fm/api/account/create
# Copy this file to .env and fill in your key. In production, set it as a
# Cloudflare Worker secret named LASTFM_API_KEY instead.
LASTFM_API_KEY=your_api_key_here
